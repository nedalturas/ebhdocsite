{% extends "base.njk" %}

{% block styles %}
<link rel="stylesheet" href="/css/docs.css">
{% endblock %}

{% block content %}
<div class="docs-page">
  <div class="docs-shell container py-4">
    <div class="docs-mobile-bar d-lg-none mb-3">
      <button class="docs-menu-toggle btn reference-btn" type="button" id="menu" aria-controls="docsSidebar" aria-expanded="false">
        <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
        <span>Browse docs</span>
      </button>
      <span class="docs-mobile-current text-truncate" id="docsCurrentTopic">Documentation</span>
    </div>

    <div class="docs-backdrop" id="docsBackdrop" aria-hidden="true"></div>

    <div class="docs-layout">
      <aside class="sidebar" id="docsSidebar" aria-label="Documentation navigation">
        <div class="sidebar-header d-lg-none">
          <span class="sidebar-title">Documentation</span>
          <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close documentation menu">
            &times;
          </button>
        </div>
        <nav>
          {% for category, docs in collections.docsByCategory %}
          <details class="category" open>
            <summary class="category-toggle">
              <span>{{ category | replace("-", " ") | title }}</span>
            </summary>
            <ul class="category-links">
              {% for doc in docs %}
              <li>
                <a href="{{ doc.url }}" class="category-link">{{ doc.data.title or doc.fileSlug }}</a>
              </li>
              {% endfor %}
            </ul>
          </details>
          {% endfor %}
        </nav>
      </aside>
      <main class="content">
        {{ content | safe }}
      </main>
    </div>
  </div>
</div>
<script src="/js/sidebar.js"></script>
{% endblock %}
