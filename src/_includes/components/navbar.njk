<head>

    <style>
        .nav-container {
            width: 100%;
            background-color: var(--pico-background-color);
            border-bottom: 1px solid var(--pico-muted-border-color);
            top: 0;
            position: sticky;
            z-index: 100;
            height: 80px;
            display: flex;
            align-items: center;
        }

        .menu {
            display: none;
            cursor: pointer;
            width: 25px;
            height: 24px;
            position: relative;
            background: transparent;
            border: none;
        }

        .menu span {
            display: block;
            position: absolute;
            height: 1px;
            width: 100%;
            background: var(--pico-muted-color);
            border-radius: 3px;
            opacity: 1;
            left: 0;
            transform: rotate(0deg);
            /* transition: 0.25s ease-in-out; */
        }

        .menu span:nth-child(1) {
            top: 0px;
        }

        .menu span:nth-child(2) {
            top: 10px;
        }

        .menu span:nth-child(3) {
            top: 20px;
        }

        .menu.open span:nth-child(1) {
            top: 10px;
            transform: rotate(135deg);
        }

        .menu.open span:nth-child(2) {
            opacity: 0;
            left: -60px;
        }

        .menu.open span:nth-child(3) {
            top: 10px;
            transform: rotate(-135deg);
        }

        @media (max-width: 960px) {

            .menu {
                display: block;
            }

        }
    </style>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/theme-toggles@4.10.1/css/expand.min.css">

</head>

<div class="nav-container">

    <nav class="container">
        <ul>


              {% if page.url.startsWith('/docs/') %}
                <div class="menu" id="menu" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
              {% endif %}
            <li>
                <strong>
                    <a href="/" class="nav-logo">{{ site.name or "My Site" }}</a>
                </strong>
            </li>
           
        </ul>


        <ul class="">

            {% for item in navigation.items %}
            <li class="">
                <a href="{{ item.url }}" class="{% if page.url == '/' %}active{% endif %}">{{ item.text }}</a>
            </li>
            {% endfor %}

            <li class="">
                <div id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                    <span class="theme-icon">🌙</span>
                </div>
            </li>
        </ul>

    </nav>
</div>
