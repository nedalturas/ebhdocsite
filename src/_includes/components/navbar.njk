    <nav class="navbar lg:navbar-expand sticky-top">
        <div class="container">

            <a href="/" class="navbar-brand">
                {{ site.name or "My Site" }}
            </a>
            <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer"
                data-bs-target="#navbarNavMenu" aria-controls="navbarNavMenu" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon" aria-hidden="true"></span>
            </button>
            <dialog class="drawer drawer-end" tabindex="-1" id="navbarNavMenu" aria-labelledby="navbarNavMenuLabel">
                <div class="drawer-header">
                    <h5 class="drawer-title" id="navbarNavMenuLabel">Menu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
                </div>
                <div class="drawer-body">
                    <ul class="navbar-nav lg:ms-auto">

                        {% for item in navigation.items %}
                        <li class="nav-item">
                            <a href="{{ item.url }}" class="nav-link {% if page.url == '/' %}active{% endif %}">{{
                                item.text
                                }}</a>
                        </li>
                        {% endfor %}


                        <li class="nav-item">
                            <div id="theme-toggle" class="theme-toggle nav-link" aria-label="Toggle theme">
                                <span class="theme-icon">🌙</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </dialog>
        </div>
    </nav>
